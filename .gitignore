# ========================
# FireGuardian .gitignore
# ========================

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg
.Python

# --- 虚拟环境 ---
.venv/
venv/
env/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- YOLO 模型权重（体积大，不提交） ---
*.pt
!models/*.md          # 保留 models 目录的说明文件

# --- 数据集（外部路径，不提交） ---
# datasets/ (handled below)

# --- 训练输出 ---
runs/
train/exp*/

# --- 日志和截图（运行时生成，不提交） ---
logs/*.log
logs/*.jsonl
logs/*.json
screenshots/
reports/*.pdf
reports/*.md
reports/*.json
reports/event_*/

# --- 系统文件 ---
Thumbs.db
.DS_Store

# --- 数据集目录（只忽略图片/标签，保留 yaml 配置） ---
datasets/*.jpg
datasets/*.png
datasets/*.txt
datasets/*.json

# --- Word 临时文件 ---
~$*.docx

# --- Ultralytics 本地配置（settings/字体缓存） ---
.ultralytics/


# --- 大数据量审计 JSON（8MB，不入库；.md 已入库） ---
tools/dataset_audit.json

# --- 临时与大型不入库文件（本任务新增） ---
*.cache
tools/_audit_work/
/烟火.mp4
/tmp_task10.txt

# --- 环境变量（含 API Key，严禁入库） ---
.env
.env.*
!.env.example

# ---- V2 封板：非源码 / 运行产物 / 大型素材（2026-08-16 封板） ----
models/*.jsonl
datasets/v2_negatives/
/*.docx
/*.mp4
/测试视频/
/展示照片/
/火堆.jpg
/bus.jpg
tools/baseline_v1_visual_audit.pdf
tools/v2_phase3_fireworks/representative_frames_*/
tools/v2_phase4a_output/
tools/v2_phase4b_screenshots/
tools/v2_final_demo/
logs/thinking_eval/

